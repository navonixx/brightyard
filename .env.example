# ─── Brightyard environment ───────────────────────────────────────────
# Copy to .env.local (local) and add the same keys in Vercel → Settings → Environment Variables.

# Admin login (required). Use a long random password.
ADMIN_PASSWORD=
# Random 32+ character string used to sign the admin cookie (required).
SESSION_SECRET=

# Public URL of the site (used in email links). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string (Neon / Supabase / any Postgres).
# Leave empty locally to use the built-in embedded database in ./.data
DATABASE_URL=

# Claude API — preferred for homepage copy and email drafts. Without any AI key, built-in templates are used.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
CLAUDE_MODEL=

# OpenAI — used for copy/emails when ANTHROPIC_API_KEY is empty.
OPENAI_API_KEY=
# Optional model override (default: gpt-5.4-mini)
OPENAI_MODEL=

# ImageKit — image uploads for previews
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Google Places API (New) — lead finder
GOOGLE_PLACES_API_KEY=

# Telegram alerts (bot token from @BotFather, chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
